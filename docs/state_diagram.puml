@startuml MiniNecesse_StateDiagrams
title MiniNecesse (v2026) — State Diagrams (GameStateMachine, Enemy/Boss AI FSM & SettlerFSM)

' =============================================================================
' PART 1: Game Lifecycle State Machine (GameStateMachine + IGameState)
' =============================================================================
state "GameStateMachine (MiniNecesse.Core.Patterns.State)" as GSM {
    [*] --> MainMenu : new GameSession(GameMode, Difficulty)

    state MainMenu : MainMenuState\nSelect Mode (Campaign / Endless Seed)\nSelect Difficulty (Tutorial / Normal / Hard)
    state Playing : PlayingState\nStepPlayingSimulation(dt)\nChunkManager, Farming, Settlement, Weather, Quests, AI, Physics
    state Paused : PausedState\nSimulation frozen\nSave / Load (save_slot_1.json) / Settings
    state Victory : VictoryState\nOnSoundEffectRequested("victory")\nRecord Bucketed High Score / Next Island
    state GameOver : GameOverState\nOnSoundEffectRequested("game_over")\n(Unreachable in Tutorial: DifficultyDamageMitigationDecorator = 0 dmg)

    MainMenu --> Playing : Start()
    Playing --> Paused : Pause() [Esc pressed]
    Paused --> Playing : Resume() [Esc / Resume]
    Paused --> MainMenu : ReturnToMainMenu()
    Playing --> Victory : RuleEngine.EvaluateOutcome()\n[IsBossDefeated == true]
    Playing --> GameOver : RuleEngine.EvaluateOutcome()\n[Player.CurrentHp == 0 && !Tutorial]
    Victory --> Playing : InitializeNewIslandSession(nextIsland) / InitializeNewEndlessSession(seed)
    Victory --> MainMenu : ReturnToMainMenu()
    GameOver --> Playing : PlayAgain()
    GameOver --> MainMenu : ReturnToMainMenu()
}

' =============================================================================
' PART 2: Enemy & Boss AI FSM (EnemyFSM + Boss.TakeDamage)
' =============================================================================
state "Enemy & Boss AI FSM (EnemyFSM + Boss)" as AIFSM {
    [*] --> Idle : EnemyFactory.CreateEnemy / CreateBoss

    state Idle : Stationary\n_stateTimer < _idleDuration
    state Patrol : Move along CurrentPatrolDirection\n_stateTimer < _patrolDuration
    state Chase : AStarPathfinder shortest path via PathfindingCoordinator\n(or breach BlockingWallTile)
    state Attack : Melee strike or RangedKiteStrategy\nprojectile shot on cooldown
    state Enraged : Boss Phase (< Threshold)\nSetAIStrategy(BossEnrageStrategy)\nSpeed x1.35, Dmg x1.25, Cooldown x0.70
    state Dead : OnHealthDepleted()\nRoll LootTableRegistry + OnDefeated

    Idle --> Patrol : _stateTimer >= _idleDuration
    Patrol --> Idle : _stateTimer >= _patrolDuration
    Idle --> Chase : distance <= DetectionRange
    Patrol --> Chase : distance <= DetectionRange
    Chase --> Patrol : distance > DetectionRange
    Chase --> Attack : distance <= AttackRange
    Attack --> Chase : distance > AttackRange
    Chase --> Enraged : Boss.TakeDamage() [IsBoss && HealthRatio < Threshold]
    Attack --> Enraged : Boss.TakeDamage() [IsBoss && HealthRatio < Threshold]
    Idle --> Dead : CurrentHp == 0
    Patrol --> Dead : CurrentHp == 0
    Chase --> Dead : CurrentHp == 0
    Attack --> Dead : CurrentHp == 0
    Enraged --> Dead : CurrentHp == 0
    Dead --> [*]
}

' =============================================================================
' PART 3: Friendly Colony Settler FSM (SettlerFSM + ISettlerStrategy)
' =============================================================================
state "Settler FSM (SettlerFSM + Miner/HunterSettlerStrategy)" as SFSM {
    [*] --> S_Idle : TryRecruitSettler()

    state S_Idle : Rest / At home shelter\nWait ambient timer
    state S_Patrol : Light ambient movement\ndusk/dawn patrol
    state S_Work : Miner approaches ore/stone nodes;\nHunter attacks nearby enemies (ranged arrows);\nAdvance Stockpile production scaled by Happiness
    state S_ReturnHome : Navigate back to HousingValidator HomeTile
    state S_Flee : Move away from nearby threat

    S_Idle --> S_Work : DayPhase.Day
    S_Patrol --> S_Work : DayPhase.Day
    S_Work --> S_ReturnHome : DayPhase.Night && HasValidHome
    S_Idle --> S_ReturnHome : DayPhase.Night && HasValidHome && dist(Home) > 28
    S_ReturnHome --> S_Idle : Reached HomeTile (dist <= 28)
    S_Idle --> S_Flee : HealthRatio < 0.50 && Enemy <= 96px
    S_Patrol --> S_Flee : HealthRatio < 0.50 && Enemy <= 96px
    S_Work --> S_Flee : HealthRatio < 0.50 && Enemy <= 96px
    S_Idle --> S_Patrol : Timer >= IdleDuration
    S_Patrol --> S_Idle : Timer >= PatrolDuration
}
@enduml
